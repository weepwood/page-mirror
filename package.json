{
  "name": "page-mirror",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "独立网站镜像项目的统一管理仓库与 GitHub Pages 目录",
  "homepage": "https://weepwood.github.io/page-mirror/",
  "scripts": {
    "validate": "node scripts/mirror-config.mjs && node scripts/validate-registry.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-site.mjs",
    "preview": "node scripts/preview.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:external": "node scripts/audit-external.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "audit": "npm run audit:links && npm run audit:external && npm run audit:build",
    "import:mirrors": "node scripts/import-mirrors.mjs",
    "add-mirror": "node scripts/add-mirror.mjs",
    "check": "npm run validate && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}
