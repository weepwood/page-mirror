{
  "manifest_version": 3,
  "name": "Inftab New Tab",
  "version": "1.0.0",
  "description": "A customizable new tab page with shortcuts, widgets, notes, tasks, weather, and opt-in news.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "optional_permissions": [
    "bookmarks",
    "clipboardWrite",
    "history",
    "tabs",
    "topSites"
  ],
  "optional_host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://hacker-news.firebaseio.com/*"
  ]
}
