ion-colors duration-150 hover:text-zinc-900 dark:decoration-zinc-700 dark:hover:text-zinc-100\">terms</a> <!-- -->and<!-- --> <a href=\"/privacy\" class=\"underline decoration-zinc-300 underline-offset-[3px] transition-colors duration-150 hover:text-zinc-900 dark:decoration-zinc-700 dark:hover:text-zinc-100\">privacy policy</a>.</p></div></div></div></div></div></div><div class=\"mx-auto w-full max-w-5xl space-y-16 px-4 py-16 sm:px-8 lg:px-16\"><section id=\"installation\" class=\"scroll-mt-24\"><h2 class=\"mb-5 text-lg font-semibold tracking-[-0.01em]\">Installation</h2><div class=\"flex flex-col gap-4\" style=\"opacity:1;transform:none\"><div class=\"flex items-center gap-2\"><span class=\"inline-flex items-center gap-1 rounded-full bg-foreground/8 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock size-3\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg> Pro</span><span class=\"text-[12px] text-muted-foreground\">Requires a Planes Pro license.</span></div><div class=\"relative overflow-hidden rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"no