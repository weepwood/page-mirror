saturate-150 p-5 shadow-xs sm:flex-row sm:items-center sm:justify-between\"><div class=\"flex items-start gap-3\"><span class=\"mt-0.5 inline-flex shrink-0 items-center rounded-lg bg-secondary p-1\"><span class=\"flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-key-round size-4\" aria-hidden=\"true\"><path d=\"M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z\"></path><circle cx=\"16.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"></circle></svg></span></span><div><p class=\"text-sm font-medium text-foreground\">Unlock with Planes Pro</p><p class=\"text-[13px] leading-5 text-muted-foreground\">$99 once · 160 Pro components · lifetime updates.</p></div></div><div class=\"inline-flex shrink-0 items-center gap-1 self-start rounded-lg bg-secondary p-1 sm:self-auto\"><a class=\"inline-flex h-9 items-center rounded-md bg-surface-overlay px-3 text-[13px] font-medium text-foreground/60 shadow-sm transition-[color,transform] duration-150 hover:text-foreground active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" href=\"/setup\">I have a license</a><a class=\"group inline-flex h-9 items-center gap-1.5 rounded-md bg-surface-overlay px-4 text-[13px] font-semibold text-foreground shadow-sm transition-[color,transform] duration-150 hover:text-foreground/80 active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" href=\"/#pricing\">Get Pro<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-3.5 transition-transform group-hover:translate-x-0.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section id=\"usage\" class=\"scroll-mt-24\"><div class=\"flex flex-col gap-5\"><div role=\"tablist\" class=\"inline-flex w-fit items-center gap-1 rounded-lg bg-neutral-200/60 dark:bg-white/5 p-1\"><button type=\"button\" role=\"tab\" id=\"_R_5anpfksnksdb_-tab-usage\" aria-selected=\"true\" aria-controls=\"_R_5anpfksnksdb_-panel-usage\" tabindex=\"0\" class=\"relative inline-flex h-9 items-center rounded-md px-4 text-[13px] font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring text-foreground\"><span class=\"absolute inset-0 rounded-md bg-white shadow-sm dark:bg-neutral-800\"></span><span class=\"relative z-10\">Usage</span></button><button type=\"button\" role=\"tab\" id=\"_R_5anpfksnksdb_-tab-props\" aria-selected=\"false\" aria-controls=\"_R_5anpfksnksdb_-panel-props\" tabindex=\"-1\" class=\"relative inline-flex h-9 items-center rounded-md px-4 text-[13px] font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring text-foreground/55 hover:text-foreground\"><span class=\"relative z-10\">Props</span></button></div><div role=\"tabpanel\" id=\"_R_5anpfksnksdb_-panel-usage\" aria-labelledby=\"_R_5anpfksnksdb_-tab-usage\" style=\"opacity:1;transform:none\"><div class=\"relative\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-4\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre class=\"overflow-x-auto rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 px-5 py-4 pr-16 shadow-xs text-[13px] leading-6\" data-language=\"tsx\"><code class=\"font-mono text-foreground/90\">import { MultiSelect } from &quot;@/components/ui/MultiSelect&quot;;\n\nconst [assignees, setAssignees] = useState&lt;string[]&gt;([]);\n\n&lt;MultiSelect\n  label=&quot;Assignees&quot;\n  placeholder=&quot;Add people…&quot;\n  value={assignees}\n  onValueChange={setAssignees}\n  options={[\n    { value: &quot;ada&quot;, label: &quot;Ada Marlow&quot;, description: &quot;Design&quot;, group: &quot;Product&quot; },\n    { value: &quot;lin&quot;, label: &quot;Lin Torres&quot;, description: &quot;Engineering&quot;, group: &quot;Platform&quot; },\n  ]}\n/&gt;</code></pre></div></div></div></section><section id=\"use-cases\" class=\"scroll-mt-24\"><h2 class=\"mb-5 text-lg font-semibold tracking-[-0.01em]\">Use cases</h2><ul class=\"grid gap-3 sm:grid-cols-2\"><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Assigning people</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Pick reviewers, assignees or attendees from a grouped directory. Chips spring into the field and collapse into +N once the list gets long.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Tags and labels</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Turn on creatable to let users add a label that does not exist yet without leaving the field.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Filter bars</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Multi-pick statuses, regions or owners; the list stays keyboard-first with wrapping arrows, Home/End and chip navigation.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Large remote datasets</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Rows are virtualised, so thousands of options scroll smoothly, and onQueryChange with loading covers server-side search.</p></li></ul></section></div><section id=\"related\" class=\"mx-auto w-full max-w-5xl scroll-mt-24 px-4 pb-16 sm:px-8 lg:px-16\" aria-labelledby=\"related-heading\"><div class=\"mb-5 flex items-baseline justify-between gap-4\"><h2 id=\"related-heading\" class=\"text-lg font-semibold tracking-[-0.01em]\">Related components</h2><a class=\"text-[13px] text-muted-foreground underline underline-offset-4 hover:text-foreground\" href=\"/components/controls\">All Controls components</a></div><div class=\"grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3\"><a class=\"group relative flex flex