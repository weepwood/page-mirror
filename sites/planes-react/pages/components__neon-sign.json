orm-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre class=\"overflow-x-auto rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 px-5 py-4 pr-16 shadow-xs text-[13px] leading-6\" data-language=\"tsx\"><code class=\"font-mono text-foreground/90\">import { NeonSign } from &quot;@/components/ui/NeonSign&quot;;\n\n&lt;NeonSign as=&quot;h1&quot; color=&quot;#ff3ea5&quot; className=&quot;text-8xl font-light&quot;&gt;\n  Open late\n&lt;/NeonSign&gt;</code></pre></div></div></div></section><section id=\"examples\" class=\"scroll-mt-24\"><h2 class=\"mb-5 text-lg font-semibold tracking-[-0.01em]\">Examples</h2><div class=\"space-y-8\"><div class=\"space-y-3\"><div><h3 class=\"text-base font-medium tracking-tight\">Two-tone sign</h3><p class=\"mt-1 text-sm text-muted-foreground\">Delay the second line so it strikes after the first one holds.</p></div><div class=\"relative\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-4\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre class=\"overflow-x-auto rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 px-5 py-4 pr-16 shadow-xs text-[13px] leading-6\" data-language=\"tsx\"><code class=\"font-mono text-foreground/90\">&lt;NeonSign as=&quot;h2&quot; className=&quot;text-8xl font-light&quot;&gt;Open late&lt;/NeonSign&gt;\n&lt;NeonSign as=&quot;p&quot; color=&quot;#38e1ff&quot; delay={1.4} className=&quot;text-2xl uppercase tracking-[0.2em]&quot;&gt;\n  Coffee and records\n&lt;/NeonSign&gt;</code></pre></div></div><div class=\"space-y-3\"><div><h3 class=\"text-base font-medium tracking-tight\">Replay</h3><p class=\"mt-1 text-sm text-muted-foreground\">The ignition plays once per mount. Change the key to strike it again.</p></div><div class=\"relative\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-4\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre class=\"overflow-x-auto rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 px-5 py-4 pr-16 shadow-xs text-[13px] leading-6\" data-language=\"tsx\"><code class=\"font-mono text-foreground/90\">&lt;NeonSign key={run}&gt;Open late&lt;/NeonSign&gt;\n&lt;button onClick={() =&gt; setRun((r) =&gt; r + 1)}&gt;Replay&lt;/button&gt;</code></pre></div></div><div class=\"space-y-3\"><div><h3 class=\"text-base font-medium tracking-tight\">Reduced motion</h3><p class=\"mt-1 text-sm text-muted-foreground\">With prefers-reduced-motion the sign is lit from the start, with no ignition and no brown-outs.</p></div><div class=\"relative\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-4\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre class=\"overflow-x-auto rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 px-5 py-4 pr-16 shadow-xs text-[13px] leading-6\" data-language=\"tsx\"><code class=\"font-mono text-foreground/90\">&lt;NeonSign&gt;Reduced motion is always on.&lt;/NeonSign&gt;</code></pre></div></div></div></section><section id=\"use-cases\" class=\"scroll-mt-24\"><h2 class=\"mb-5 text-lg font-semibold tracking-[-0.01em]\">Use cases</h2><ul class=\"grid gap-3 sm:grid-cols-2\"><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Hero headline</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">A brand name or tagline that switches on as the page loads, on a dark hero.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Event and nightlife</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Venue, bar, music or event pages where the sign is the mood.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Status sign</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">An Open, Live or On Air sign that flickers on when the state turns true.</p></li><li class=\"roun