Planes } from &quot;@/components/ui/PhotoPlanes&quot;;\n\n&lt;PhotoPlanes\n  images={[\n    { src: &quot;/photos/one.webp&quot;, alt: &quot;Backstage&quot; },\n    { src: &quot;/photos/two.webp&quot;, alt: &quot;Soundcheck&quot; },\n    { src: &quot;/photos/three.webp&quot;, alt: &quot;Crowd&quot; },\n  ]}\n/&gt;</code></pre></div></div></div></section><section id=\"examples\" class=\"scroll-mt-24\"><h2 class=\"mb-5 text-lg font-semibold tracking-[-0.01em]\">Examples</h2><div class=\"space-y-8\"><div class=\"space-y-3\"><div><h3 class=\"text-base font-medium tracking-tight\">Looping</h3><p class=\"mt-1 text-sm text-muted-foreground\">Re-deal every six seconds, with a flatter, wider fan for a wide section. Autoplay shorter than the deal itself waits for the fan before re-dealing.</p></div><div class=\"relative\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-4\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre clas