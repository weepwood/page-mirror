vg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-square-terminal size-4 shrink-0 text-muted-foreground\" aria-hidden=\"true\"><path d=\"m7 11 2-2-2-2\"></path><path d=\"M11 13h4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" ry=\"2\"></rect></svg><div role=\"tablist\" aria-label=\"Package manager\" class=\"flex items-center\"><button type=\"button\" role=\"tab\" id=\"_R_aiinpfksnksdb_-tab-pnpm\" aria-selected=\"true\" aria-controls=\"_R_aiinpfksnksdb_-panel\" tabindex=\"0\" class=\"relative px-2.5 py-2.5 font-mono text-[12px] transition-colors duration-150 text-foreground\">pnpm<span class=\"absolute inset-x-2 -bottom-px h-px bg-foreground\"></span></button><button type=\"button\" role=\"tab\" id=\"_R_aiinpfksnksdb_-tab-npm\" aria-selected=\"false\" aria-controls=\"_R_aiinpfksnksdb_-panel\" tabindex=\"-1\" class=\"relative px-2.5 py-2.5 font-mono text-[12px] transition-colors duration-150 text-muted-foreground/70 hover:text-foreground\">npm</button><button type=\"button\" role=\"tab\" id=\"_R_aiinpfksnksdb_-tab-yarn\" aria-selected=\"false\" aria-controls=\"_R_aiinpfksnksdb_-panel\" tabindex=\"-1\" class=\"relative px-2.5 py-2.5 font-mono text-[12px] transition-colors duration-150 text-muted-foreground/70 hover:text-foreground\">yarn</button><button type=\"button\" role=\"tab\" id=\"_R_aiinpfksnksdb_-tab-bun\" aria-selected=\"false\" aria-controls=\"_R_aiinpfksnksdb_-panel\" tabindex=\"-1\" class=\"relative px-2.5 py-2.5 font-mono text-[12px] transition-colors duration-150 text-muted-foreground/70 hover:text-foreground\">bun</button></div></div><button type=\"button\" aria-label=\"Copy\" aria-live=\"polite\" class=\"relative flex size-7 select-none items-center justify-center rounded-md border border-border/70 bg-background/70 text-muted-foreground transition-[color,transform] duration-150 ease-out hover:text-foreground active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring my-1.5\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-3.5\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></div><pre role=\"tabpanel\" id=\"_R_aiinpfksnksdb_-panel\" aria-labelledby=\"_R_aiinpfksnksdb_-tab-pnpm\" class=\"overflow-x-auto bg-muted/20 px-4 py-3.5 text-[13px] leading-6\"><code class=\"font-mono text-foreground/90\">pnpm dlx shadcn@latest init</code></pre></div></div></div></section><section id=\"pro-components\" class=\"flex scroll-mt-24 gap-5 sm:gap-8\"><span class=\"pt-1 font-mono text-[12px] tabular-nums leading-6 text-muted-foreground/50\">02</span><div class=\"flex min-w-0 flex-1 flex-col gap-4\"><h2 class=\"text-lg font-semibold leading-7 tracking-[-0.01em]\">Add Pro components</h2><p class=\"text-sm leading-6 text-muted-foreground\">Most Planes components are Pro. They are served through an authenticated registry, so they need a<!-- --> <a class=\"text-foreground underline-offset-4 hover:underline\" href=\"/#pricing\">Planes Pro license</a> <!-- -->configured once per project.</p><div class=\"flex flex-col gap-6\"><p class=\"text-[13px] leading-6 text-muted-foreground\">No key yet?<!-- --> <a href=\"/api/checkout\" class=\"text-foreground underline underline-offset-4\">Buy Planes Pro</a> <!-- -->— your key arrives by email right after checkout.</p><div class=\"flex flex-col gap-2\"><label for=\"license\" class=\"text-sm font-medium text-foreground\">License key</label><input id=\"license\" placeholder=\"XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX\" autoComplete=\"off\" spellCheck=\"false\" class=\"w-full rounded-xl border border-border/70 bg-muted/30 px-4 py-3 font-mono text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground/50 focus:border-foreground/30 focus:bg-background\" value=\"\"/></div><div class=\"flex flex-col gap-5\"><div role=\"tablist\" class=\"inline-flex w-fit items-center gap-1 rounded-lg bg-neutral-200/60 dark:bg-white/5 p-1\"><button type=\"button\" role=\"tab\" id=\"_R_1qjinpfksnksdb_-tab-cli\" aria-selected=\"true\" aria-controls=\"_R_1qjinpfksnksdb_-panel-cli\" tabindex=\"0\" class=\"relative inline-flex h-9 items-center rounded-md px-4 text-[13px] font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring text-foreground\"><span class=\"absolute inset-0 rounded-md bg-white shadow-sm dark:bg-neutral-800\"></span><span class=\"relative z-10\">CLI</span></button><button type=\"button\" role=\"tab\" id=\"_R_1qjinpfksnksdb_-tab-manual\" aria-selected=\"false\" aria-controls=\"_R_1qjinpfksnksdb_-panel-manual\" tabindex=\"-1\" class=\"relative inline-flex h-9 items-center rounded-md px-4 text-[13px] font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring text-foreground/55 hover:text-foreground\"><span class=\"relative z-10\">Manual</span></button></div><div role=\"tabpanel\" id=\"_R_1qjinpfksnksdb_-panel-cli\" aria-labelledby=\"_R_1qjinpfksnksdb_-tab-cli\" style=\"opacity:1;transform:none\"><div class=\"flex flex-col gap-6\"><p class=\"text-sm leading-6 text-muted-foreground\">One command merges the <code class=\"rounded bg-foreground/10 px-1 py-0.5 font-mono text-[12px] text-foreground\">@useplanes</code> registry into your<!-- --> <code class=\"rounded bg-foreground/10 px-1 py-0.5 font-mono text-[12px] text-foreground\">components.json</code>, writes your key to<!-- --> <code class=\"rounded bg-foreground/10 px-1 py-0.5 font-mono text-[12px] text-foreground\">.env.local</code>, and keeps it out of git.</p><div class=\"flex flex-col gap-2.5\"><p class=\"text-sm leading-6 text-foreground/80\">Run <code class=\"rounded bg-foreground/10 px-1 py-0.5 font-mono text-[12px] text-foreground\">init</code> — it configures everything for you.</p><div class=\"relative\"><span aria-hidden=\"true\" class=\"pointer-events-none absolute z-10 h-[9px] w-[9px] -left-[5px] -top-[5px]\"><span class=\"absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-foreground/30 dark:bg-white/30\"></span><span class=\"absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-foreground/30 dark:bg-white/30\"></span></span><span aria-hidden=\"true\" class=\"pointer-events-none absolute z-10 h-[9px] w-[9px] -right-[5px] -top-[5px]\"><span class=\"absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-foreground/30 dark:bg-white/30\"></span><span class=\"absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-foreground/30 dark:bg-white/30\"></span></span><span aria-hidden=\"true\" class=\"pointer-events-none absolute z-10 h-[9px] w-[9px] -bottom-[5px] -left-[5px]\"><span class=\"absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-foreground/30 dark:bg-white/30\"></span><span class=\"absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-foreground/30 dark:bg-white/30\"></span></span><span aria-hidden=\"true\" class=\"pointer-events-none absolute z-10 h-[9px] w-[9px] -bottom-[5px] -right-[5px]\"><span class=\"absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-foreground/30 dark:bg-white/30\"></span><span class=\"absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-foreground/30 dark:bg-white/30\"></span></span><div class=\"overflow-hidden rounded-lg border border-border/70 bg-background\"><div class=\"flex items-center justify-between gap-3 b