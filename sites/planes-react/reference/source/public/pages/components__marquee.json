nsform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre class=\"overflow-x-auto rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 px-5 py-4 pr-16 shadow-xs text-[13px] leading-6\" data-language=\"tsx\"><code class=\"font-mono text-foreground/90\">import { Marquee } from &quot;@/components/ui/Marquee&quot;;\n\n&lt;Marquee speed={40} pauseOnHover=&quot;slow&quot; fade&gt;\n  {logos.map((l) =&gt; &lt;Logo key={l.id} {...l} /&gt;)}\n&lt;/Marquee&gt;</code></pre></div></div></div></section><section id=\"examples\" class=\"scroll-mt-24\"><h2 class=\"mb-5 text-lg font-semibold tracking-[-0.01em]\">Examples</h2><div class=\"space-y-8\"><div class=\"space-y-3\"><div><h3 class=\"text-base font-medium tracking-tight\">Two opposing rows</h3><p class=\"mt-1 text-sm text-muted-foreground\">Compose rows; each Marquee owns its own frame loop and pauses when scrolled out of view or the tab is hidden.</p></div><div class=\"relative\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-4\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></path><rect x=\"8\" y=\"8\" width=\"14\" height=\"14\" rx=\"2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"></rect><path d=\"M5 12.5l4.5 4.5L19 7.5\" class=\"text-emerald-500 dark:text-emerald-400\" stroke-width=\"2.5\" opacity=\"0\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></path></svg></button></span></div><pre class=\"overflow-x-auto rounded-xl border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 px-5 py-4 pr-16 shadow-xs text-[13px] leading-6\" data-language=\"tsx\"><code class=\"font-mono text-foreground/90\">&lt;Marquee speed={40}&gt;{cards}&lt;/Marquee&gt;\n&lt;Marquee speed={40} direction=&quot;right&quot;&gt;{cards}&lt;/Marquee&gt;</code></pre></div></div><div class=\"space-y-3\"><div><h3 class=\"text-base font-medium tracking-tight\">Reduced motion</h3><p class=\"mt-1 text-sm text-muted-foreground\">Renders a single static, natively scrollable row with no frame loop and no edge mask.</p></div><div class=\"relative\"><div class=\"absolute right-3 top-3 z-10\"><span class=\"inline-flex items-center gap-1 rounded-lg bg-secondary p-1\"><button type=\"button\" aria-label=\"Copy\" class=\"relative inline-flex size-7 items-center justify-center rounded-md bg-surface-overlay text-foreground shadow-sm transition-colors duration-150 will-change-transform hover:bg-surface-overlay/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" tabindex=\"0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"shrink-0 size-4\" aria-hidden=\"true\"><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" opacity=\"1\" style=\"transform:none;transform-origin:50% 50%;transfor