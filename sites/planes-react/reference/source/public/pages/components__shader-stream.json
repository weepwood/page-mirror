alues: [20, 24, 29, 35, 52, 61, 48], colors: [&quot;#000000&quot;, &quot;#7e22ce&quot;, &quot;#e9d5ff&quot;] },\n    { name: &quot;Social&quot;, values: [8, 15, 27, 23, 19, 30, 41] },\n  ]}\n  labels={[&quot;Mon&quot;, &quot;Tue&quot;, &quot;Wed&quot;, &quot;Thu&quot;, &quot;Fri&quot;, &quot;Sat&quot;, &quot;Sun&quot;]}\n/&gt;</code></pre></div></div></div></section><section id=\"use-cases\" class=\"scroll-mt-24\"><h2 class=\"mb-5 text-lg font-semibold tracking-[-0.01em]\">Use cases</h2><ul class=\"grid gap-3 sm:grid-cols-2\"><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Traffic by channel</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Direct, search, social and referral traffic as one river that shows how the mix shifts month to month.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Revenue by product line</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Launches show up as bumps that swell and settle while the whole stays readable.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Listening history</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Genres over a year on a music profile, each band in its own colour world.</p></li><li class=\"rounded-lg border border-black/5 dark:border-white/5 bg-neutral-50/80 dark:bg-neutral-900/95 backdrop-blur-xl backdrop-saturate-150 p-4 shadow-xs\"><p class=\"text-sm font-medium tracking-tight\">Workload by team</p><p class=\"mt-1 text-[13px] leading-5 text-muted-foreground\">Tickets or deploy